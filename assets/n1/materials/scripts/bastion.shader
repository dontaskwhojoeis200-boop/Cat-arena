
// ---------------------------------------------------------------------------
// BASTION KEEP: reactor beam and lamp emissives (the kit's per-asset materials
// are generated by js/engine/kit-models.js: diffuse x $vertexlight + glow)
// ---------------------------------------------------------------------------
// beam core: a single autosprite2 quad turned toward the viewer about the
// beam axis, two scrolling additive layers (collapsed into one pass)
models/bastion/reactor_beam
{
	deformVertexes autosprite2
	cull none
	sort additive
	surfaceparm nolightmap
	{
		map textures/gallery/energy
		blendFunc add
		tcMod scale 1 6
		tcMod scroll 0 -1.6
		rgbGen const ( 1.0 .52 .14 )
	}
	{
		map textures/gallery/plasma
		blendFunc add
		tcMod scale 1 3
		tcMod scroll .05 -.9
		rgbGen wave sin .55 .2 0 1.3
	}
}
// soft outer glow around the core
models/bastion/reactor_glow
{
	deformVertexes autosprite2
	cull none
	sort additive
	surfaceparm nolightmap
	{
		map textures/gallery/flare
		blendFunc add
		tcMod scale 1 .25
		rgbGen wave sin .34 .08 0 .45
	}
}
// emitter / collector flares
models/bastion/reactor_flare
{
	deformVertexes autosprite
	sort additive
	surfaceparm nolightmap
	{
		map textures/gallery/flare
		blendFunc add
		rgbGen wave noise .85 .15 0 2
	}
}
// lamp housings: emissive insets built by the engine (the diffuse paint does not emit)
models/bastion/lamp_amber
{
	surfaceparm nolightmap
	cull none
	sort additive
	{
		map $whiteimage
		blendFunc add
		rgbGen wave sin .78 .1 0 .7
	}
}
models/bastion/lamp_green
{
	surfaceparm nolightmap
	cull none
	sort additive
	{
		map $whiteimage
		blendFunc add
		rgbGen const ( .32 .92 .48 )
	}
}
models/bastion/lamp_strip
{
	surfaceparm nolightmap
	cull none
	sort additive
	{
		map $whiteimage
		blendFunc add
		rgbGen wave sin .82 .14 .25 .55
	}
}
