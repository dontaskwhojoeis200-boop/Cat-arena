# N6.5: makes vulkan-1.lib with cmake/cat_vulkan_import_library.cmake (the code the Windows build runs)
# and checks with llvm-nm that it imports every allowed command from vulkan-1.dll.
#   cmake -DTOOL=<lib.exe|llvm-lib> -DNM=<llvm-nm> -DALLOW=<vulkan_baseline_imports.txt> -DOUT=<dir> -P vulkan_import_library_check.cmake
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/cat_vulkan_import_library.cmake")
cat_vulkan_import_library("${ALLOW}" "${TOOL}" "${OUT}" lib)
execute_process(COMMAND "${NM}" "${lib}" OUTPUT_VARIABLE symbols RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "${NM} failed: ${err}")
endif()
file(STRINGS "${ALLOW}" wanted REGEX "^vk[A-Za-z0-9_]+$")
set(missing "")
foreach(cmd IN LISTS wanted)
  if(NOT symbols MATCHES "__imp_${cmd}[\r\n]")
    list(APPEND missing ${cmd})
  endif()
endforeach()
string(REGEX MATCHALL "vulkan-1\\.dll" dll "${symbols}")
if(missing)
  message(FATAL_ERROR "vulkan-1.lib lacks import thunks for: ${missing}")
endif()
list(LENGTH wanted n)
message("PASS vulkan-1.lib: ${n} commands imported from vulkan-1.dll (${lib_COUNT} in the .def)")
