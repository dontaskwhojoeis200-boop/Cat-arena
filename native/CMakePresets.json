{
  "version": 5,
  "configurePresets": [
    {
      "name": "core-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CAT_BUILD_DESKTOP": "OFF"
      }
    },
    {
      "name": "core-release",
      "inherits": "core-debug",
      "binaryDir": "${sourceDir}/build/core-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "desktop-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CAT_BUILD_DESKTOP": "ON",
        "CAT_FETCH_SDL": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release (MSVC, Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CAT_BUILD_DESKTOP": "ON",
        "CAT_FETCH_SDL": "ON",
        "CAT_FETCH_GLSLANG": "ON",
        "CAT_WINDOWS_GUI": "ON",
        "CAT_MILESTONE": "N11"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core-debug",
      "configurePreset": "core-debug"
    },
    {
      "name": "core-release",
      "configurePreset": "core-release"
    },
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "core-debug",
      "configurePreset": "core-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-release",
      "configurePreset": "core-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "gpu"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-release-gpu",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "gpu"
        }
      }
    }
  ]
}
