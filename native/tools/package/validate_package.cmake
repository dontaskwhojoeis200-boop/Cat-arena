# N6.5: checks a game folder made by `cmake --install` before it is zipped.
#   cmake -DPACKAGE_DIR=<dir> -DPLATFORM=windows|linux [-DSHADER_COUNT=23] -P validate_package.cmake
# Fails (non-zero exit) if a mandatory file is missing or a development-only file slipped in.
if(NOT PACKAGE_DIR OR NOT IS_DIRECTORY "${PACKAGE_DIR}")
  message(FATAL_ERROR "PACKAGE_DIR is not a directory: ${PACKAGE_DIR}")
endif()
get_filename_component(PACKAGE_DIR "${PACKAGE_DIR}" ABSOLUTE)
if(NOT SHADER_COUNT)
  set(SHADER_COUNT 23)
endif()
if(PLATFORM STREQUAL "windows")
  set(exe "CatArena.exe")
  set(runtime "SDL3.dll")
else()
  set(exe "cat_arena")
  set(runtime "libSDL3.so.0")
endif()
set(required "${exe}" "${runtime}" README.txt THIRD_PARTY_LICENSES.txt assets/n1/catalog.cadata assets/n2/world-atlas-runtime.png
             assets/n4/skybox-env-gallery_nebula.png assets/n5/fx-atlas.png assets/n5/weapon-assets.json assets/n6/marine.emesh assets/n6/enemy-assets.json
             assets/n7/audio/main-theme.mp3 assets/n7/audio/sfx/bank.txt assets/n7/ui/feral-bg.png assets/n7/N7_ASSET_MANIFEST.json
             assets/n7/fonts/LiberationSerif-Bold.ttf assets/n7/fonts/LiberationSans-Bold.ttf assets/n7/fonts/LiberationMono-Bold.ttf assets/n7/fonts/LiberationSerif-Regular.ttf assets/n7/fonts/DejaVuSans-Bold.ttf)
foreach(map helios-crucible bastion-keep reactor-bastion q3-gallery)
  list(APPEND required "assets/n1/maps/${map}/map.cadata" "assets/n6/light-volume/${map}.png")
endforeach()
set(missing "")
foreach(f IN LISTS required)
  if(NOT EXISTS "${PACKAGE_DIR}/${f}")
    list(APPEND missing "${f}")
  endif()
endforeach()
file(GLOB shaders "${PACKAGE_DIR}/assets/shaders/*.spv")
list(LENGTH shaders shader_count)
file(GLOB guns "${PACKAGE_DIR}/assets/n5/weapons/*.gun")
list(LENGTH guns gun_count)
file(GLOB creatures "${PACKAGE_DIR}/assets/n6/enemies/*.emesh")
list(LENGTH creatures creature_count)
file(GLOB sounds "${PACKAGE_DIR}/assets/n7/audio/sfx/*.ogg")
list(LENGTH sounds sound_count)
file(GLOB_RECURSE all_files LIST_DIRECTORIES false "${PACKAGE_DIR}/*")
set(forbidden "")
foreach(f IN LISTS all_files)
  file(RELATIVE_PATH rel "${PACKAGE_DIR}" "${f}")
  # development leftovers, a bundled Vulkan loader / SDK, layers, the shader compiler
  if(rel MATCHES "\\.(lib|pdb|ilk|obj|o|exp|a|cpp|hpp|h|cmake)$" OR rel MATCHES "(^|/)CMakeCache\\.txt$" OR rel MATCHES "(^|/)(vulkan-1\\.dll|libvulkan\\.so[.0-9]*)$"
     OR rel MATCHES "(^|/)VkLayer" OR rel MATCHES "(^|/)glslang")
    list(APPEND forbidden "${rel}")
  endif()
endforeach()
list(LENGTH all_files file_count)
set(bytes 0)
foreach(f IN LISTS all_files)
  file(SIZE "${f}" s)
  math(EXPR bytes "${bytes} + ${s}")
endforeach()
math(EXPR mib "${bytes} / 1048576")
set(problems "")
if(missing)
  list(APPEND problems "missing: ${missing}")
endif()
if(NOT shader_count EQUAL SHADER_COUNT)
  list(APPEND problems "assets/shaders has ${shader_count} SPIR-V files, expected ${SHADER_COUNT}")
endif()
if(NOT gun_count EQUAL 16)
  list(APPEND problems "assets/n5/weapons has ${gun_count} weapon models, expected 16")
endif()
if(NOT creature_count EQUAL 20)
  list(APPEND problems "assets/n6/enemies has ${creature_count} creature meshes, expected 20")
endif()
if(NOT sound_count EQUAL 48)
  list(APPEND problems "assets/n7/audio/sfx has ${sound_count} sound files, expected 48")
endif()
if(forbidden)
  list(APPEND problems "development-only files in the package: ${forbidden}")
endif()
if(problems)
  string(REPLACE ";" "\n  " text "${problems}")
  message(FATAL_ERROR "Package check FAILED (${PACKAGE_DIR}):\n  ${text}")
endif()
message("Package check PASS: ${PACKAGE_DIR}: ${exe}, ${runtime}, ${shader_count} shaders, 4 maps, ${gun_count} weapon models, ${creature_count} creature meshes, README.txt, THIRD_PARTY_LICENSES.txt; ${file_count} files, ${mib} MiB; no development files")
