# N9: crashes CatArena on purpose (--crash-test KIND) and checks the crash report it leaves.
#   cmake -DEXE=<cat_arena> -DKIND=access|terminate|abort|divide -DDIR=<report dir> [-DEXPECT=<text>] -P crash_test.cmake
file(REMOVE_RECURSE "${DIR}")
execute_process(COMMAND "${EXE}" --crash-test "${KIND}" --crash-dir "${DIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(rc EQUAL 0)
  message(FATAL_ERROR "FAIL crash test ${KIND}: the process exited normally")
endif()
file(GLOB reports "${DIR}/CatArena-crash-*.txt")
list(LENGTH reports n)
if(NOT n EQUAL 1)
  message(FATAL_ERROR "FAIL crash test ${KIND}: expected one report in ${DIR}, found ${n} (exit ${rc})\n${err}")
endif()
file(READ "${reports}" text)
foreach(needle "crash report" "Build:   Cat Arena: Feral Claw" "Reason:" "Last log lines:" "Deliberate crash for --crash-test ${KIND}" ${EXPECT})
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "FAIL crash test ${KIND}: the report lacks '${needle}'\n${text}")
  endif()
endforeach()
set(dump_note "")
if(CMAKE_HOST_WIN32)   # script mode: WIN32 is not defined here
  file(GLOB dumps "${DIR}/CatArena-crash-*.dmp")
  list(LENGTH dumps nd)
  if(NOT nd EQUAL 1)
    message(FATAL_ERROR "FAIL crash test ${KIND}: no minidump next to the report\n${text}")
  endif()
  file(SIZE "${dumps}" dump_size)
  if(dump_size LESS 1024)
    message(FATAL_ERROR "FAIL crash test ${KIND}: minidump of ${dump_size} bytes")
  endif()
  set(dump_note ", minidump ${dump_size} bytes")
endif()
string(REGEX MATCH "Reason:  [^\r\n]*" reason "${text}")
message(STATUS "PASS crash test ${KIND}: exit ${rc}, report written (${reason}${dump_note})")
