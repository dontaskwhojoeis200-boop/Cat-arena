// Cat Arena: Feral Claw — shaders of the stage-B base folder (generated by tools/q3e/make_base.py)

white
{
	{
		map *white
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen vertex
	}
}

textures/common/trigger
{
	surfaceparm nodraw
	surfaceparm nolightmap
	surfaceparm nonsolid
	surfaceparm trigger
}

textures/common/caulk
{
	surfaceparm nodraw
	surfaceparm nolightmap
	surfaceparm nomarks
}

textures/catarena/light_panel
{
	qer_editorimage textures/catarena/light_panel.png
	q3map_surfacelight 900
	q3map_lightRGB 1.0 0.92 0.78
	surfaceparm nomarks
	{
		map $lightmap
		rgbGen identity
	}
	{
		map textures/catarena/light_panel.png
		blendFunc GL_DST_COLOR GL_ZERO
		rgbGen identity
	}
	{
		map textures/catarena/light_panel.png
		blendFunc GL_ONE GL_ONE
	}
}

textures/catarena/trim_brass
{
	qer_editorimage textures/catarena/trim_brass.png
	{
		map $lightmap
		rgbGen identity
	}
	{
		map textures/catarena/trim_brass.png
		blendFunc GL_DST_COLOR GL_ZERO
		rgbGen identity
	}
	{
		map textures/catarena/trim_brass.png
		blendFunc GL_ONE GL_ONE
		rgbGen wave sin 0.05 0.05 0 0.25
	}
}
